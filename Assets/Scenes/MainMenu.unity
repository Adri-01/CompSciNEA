--- !u!114 &449237784
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 449237782}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "This project aims to improve the traditional racing line system in racing
    games by introducing a dynamically adaptive racing line. Instead of using a fixed,
    static line that players must follow, this system will use a pursuit algorithm
    that adjusts the racing line in real-time based on the player's current position
    and speed on the track. The dynamic racing line will essentially \"chase\" the
    vehicle, updating itself as the car moves, creating a more immersive and interactive
    driving experience. The key idea is that the racing line won't just show the
    optimal path ahead but will adapt based on how the player drives, correcting
    deviations to help them return to the optimal racing trajectory.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0161d805a3764c089bef00bfe00793f5, type: 2}
  m_sharedMaterial: {fileID: 2147374, guid: 0161d805a3764c089bef00bfe00793f5, type: 2}
