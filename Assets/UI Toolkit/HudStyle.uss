.LiveLabels {
}

.BaseUI {
    -unity-font: url("project://database/Assets/TextMesh%20Pro/Examples%20&%20Extras/Fonts/Anton.ttf?fileID=12800000&guid=997a43b767814dd0a7642ec9b78cba41&type=3#Anton");
    font-size: 40px;
    color: rgb(255, 255, 255);
    -unity-font-definition: initial;
    margin-top: 4px;
    margin-right: 4px;
    margin-bottom: 2px;
    margin-left: 2px;
    align-items: flex-start;
    flex-direction: column;
    flex-wrap: wrap;
    white-space: normal;
    align-self: auto;
    position: relative;
    justify-content: space-between;
    -unity-text-outline-width: 0;
    text-shadow: 2px -3px 10px rgb(0, 0, 0);
}
